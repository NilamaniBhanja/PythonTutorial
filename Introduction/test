

using System;
using System.Data;
using System.Data.SqlClient;
using Oracle.ManagedDataAccess.Client;

namespace IMDApplication
{
    public class UpdateChildIMD
    {
        private readonly string sqlConnectionString =
            "Data Source=YOUR_SQL_SERVER,8190;" +
            "Initial Catalog=new1;" +
            "User ID=YOUR_USER;" +
            "Password=YOUR_PASSWORD;";

        private readonly string oracleConnectionString =
            "User Id=YOUR_ORACLE_USER;" +
            "Password=YOUR_ORACLE_PASSWORD;" +
            "Data Source=YOUR_ORACLE_TNS;";

        // Check IMD existence
        private const string CheckIMDQuery = @"
            SELECT COUNT(1)
            FROM imddetails
            WHERE SPCode = @IMDCode";

        // Fetch child IMD details
        private const string FetchChildIMDQuery = @"
            SELECT DISTINCT
                imd.ID AS ID,
                imd.SPCode AS SPCode,
                imd.SalesManagerID AS SalesManagerID,
                imd.ParentID AS ParentID,
                imd.ChannelID AS ChannelID,
                ext.UserID AS UserID,
                ext.UserExtID AS UserExtID,
                ext.UserName AS UserName,
                ext.RMUID AS RMUID,
                ext.RMRID AS RMRID,
                ext.FirstName AS Agent_FirstName,
                ext.LastName AS Agent_LastName,
                ext.BranchID AS BranchID,
                brn.Name AS City_Name,
                brn.OfficeType AS OfficeType,
                brn.AddressLine1 AS AddressLine1,
                brn.AddressLine2 AS AddressLine2,
                brn.AddressLine3 AS AddressLine3,
                brn.Locality AS Locality,
                brn.PinCode AS PinCode,
                brn.ISDCode AS ISDCode,
                brn.STDCode AS STDCode,
                brn.Telephone AS Telephone,
                brn.CityName AS CityName,
                brn.StateName AS StateName,
                brn.BranchCode AS BranchCode,
                bsic.FirstName AS IMDFirstName,
                bsic.MiddleName AS IMDMiddleName,
                bsic.LastName AS IMDLastName,
                bsic.DOB AS DOB,
                bsic.PAN AS PAN,
                bsic.GstNumber AS GSTNumber,
                imd.TieUpCode AS TieUpCode,
                imd.LicenseExpiryDate AS LicenseExpiryDate

            FROM imddetails imd

            INNER JOIN tbluserext ext
                ON imd.SalesManagerID = ext.UserID

            INNER JOIN masbranches brn
                ON brn.ID = ext.BranchID

            INNER JOIN Basicdetails bsic
                ON bsic.ID = imd.BasicDetailsID

            WHERE imd.ParentID IN
            (
                SELECT ID
                FROM imddetails
                WHERE SPCode = @IMDCode
            )
            AND imd.TieUpCode = @POSPCode";

        // Oracle insert query
        private const string OracleInsertQuery = @"
            INSERT INTO TBLPOSPDETAILS
            (
                ID, SPCODE, SALESMANAGERID, PARENTID, CHANNELID,
                USERID, USEREXTID, USERNAME, RMUID, RMRID,
                AGENT_FIRSTNAME, AGENT_LASTNAME, BRANCHID,
                CITYNAME, OFFICETYPE, ADDRESSLINE1, ADDRESSLINE2,
                ADDRESSLINE3, LOCALITY, PINCODE, ISDCODE, STDCODE,
                TELEPHONE, CITY_NAME, STATENAME, BRANCHCODE,
                IMDFIRSTNAME, IMDMIDDLENAME, IMDLASTNAME, DOB,
                PAN, GSTNUMBER, TIEUPCODE, LICENSEEXPIRYDATE
            )
            VALUES
            (
                :ID, :SPCODE, :SALESMANAGERID, :PARENTID, :CHANNELID,
                :USERID, :USEREXTID, :USERNAME, :RMUID, :RMRID,
                :AGENT_FIRSTNAME, :AGENT_LASTNAME, :BRANCHID,
                :CITYNAME, :OFFICETYPE, :ADDRESSLINE1, :ADDRESSLINE2,
                :ADDRESSLINE3, :LOCALITY, :PINCODE, :ISDCODE, :STDCODE,
                :TELEPHONE, :CITY_NAME, :STATENAME, :BRANCHCODE,
                :IMDFIRSTNAME, :IMDMIDDLENAME, :IMDLASTNAME, :DOB,
                :PAN, :GSTNUMBER, :TIEUPCODE, :LICENSEEXPIRYDATE
            )";

        public string Update(string imdCode, string pospCode)
        {
            DataTable dt = new DataTable();

            // STEP 1: Check IMD existence
            using (SqlConnection con =
                   new SqlConnection(sqlConnectionString))
            {
                con.Open();

                using (SqlCommand cmd =
                       new SqlCommand(CheckIMDQuery, con))
                {
                    cmd.Parameters.Add("@IMDCode",
                        SqlDbType.NVarChar).Value = imdCode;

                    int count = Convert.ToInt32(
                        cmd.ExecuteScalar());

                    if (count == 0)
                    {
                        return "IMDCode does not exists in the AVO DB";
                    }
                }

                // STEP 2: Fetch child IMD records
                using (SqlCommand cmd =
                       new SqlCommand(FetchChildIMDQuery, con))
                {
                    cmd.Parameters.Add("@IMDCode",
                        SqlDbType.NVarChar).Value = imdCode;

                    cmd.Parameters.Add("@POSPCode",
                        SqlDbType.NVarChar).Value = pospCode;

                    using (SqlDataAdapter da =
                           new SqlDataAdapter(cmd))
                    {
                        da.Fill(dt);
                    }
                }
            }

            if (dt.Rows.Count == 0)
            {
                return "No child IMD records found.";
            }

            // STEP 3: Insert records into Oracle
            using (OracleConnection con =
                   new OracleConnection(oracleConnectionString))
            {
                con.Open();

                using (OracleTransaction transaction =
                       con.BeginTransaction())
                {
                    try
                    {
                        int insertedCount = 0;

                        foreach (DataRow row in dt.Rows)
                        {
                            using (OracleCommand cmd =
                                   new OracleCommand(
                                       OracleInsertQuery, con))
                            {
                                cmd.Transaction = transaction;
                                cmd.BindByName = true;

                                string[] columns =
                                {
                                    "ID", "SPCODE", "SALESMANAGERID",
                                    "PARENTID", "CHANNELID", "USERID",
                                    "USEREXTID", "USERNAME", "RMUID",
                                    "RMRID", "AGENT_FIRSTNAME",
                                    "AGENT_LASTNAME", "BRANCHID",
                                    "CITYNAME", "OFFICETYPE",
                                    "ADDRESSLINE1", "ADDRESSLINE2",
                                    "ADDRESSLINE3", "LOCALITY",
                                    "PINCODE", "ISDCODE", "STDCODE",
                                    "TELEPHONE", "CITY_NAME", "STATENAME",
                                    "BRANCHCODE", "IMDFIRSTNAME",
                                    "IMDMIDDLENAME", "IMDLASTNAME",
                                    "DOB", "PAN", "GSTNUMBER",
                                    "TIEUPCODE", "LICENSEEXPIRYDATE"
                                };

                                foreach (string column in columns)
                                {
                                    object value = row[column];

                                    cmd.Parameters.Add(
                                        column,
                                        value == DBNull.Value
                                            ? DBNull.Value
                                            : value);
                                }

                                cmd.ExecuteNonQuery();
                                insertedCount++;
                            }
                        }

                        transaction.Commit();

                        return insertedCount +
                               " records inserted successfully.";
                    }
                    catch
                    {
                        transaction.Rollback();
                        throw;
                    }
                }
            }
        }
    }
}

