using System;
using System.IO;
using System.Net;
using System.Net.Http;
using System.Security.Cryptography;
using System.Threading.Tasks;
using System.Web.Http;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;

public class UserController : ApiController
{
    [HttpPost]
    [Route("api/User/decryptInput")]
    public async Task<HttpResponseMessage> UserDecrypt()
    {
        string body = await Request.Content.ReadAsStringAsync();

        try
        {
            // Remove quotes if encrypted value is sent as a JSON string
            string encryptedText = body.Trim().Trim('"');

            // Decrypt the encrypted value into a JSON object
            JToken decrypted =
                AESCryptography.DecryptRequest<JToken>(encryptedText);

            return Request.CreateResponse(HttpStatusCode.OK, decrypted);
        }
        catch (FormatException)
        {
            return Request.CreateErrorResponse(
                HttpStatusCode.BadRequest,
                "Invalid encrypted Base64 value.");
        }
        catch (CryptographicException)
        {
            return Request.CreateErrorResponse(
                HttpStatusCode.BadRequest,
                "Decryption failed. Invalid encrypted value or encryption key.");
        }
        catch (JsonException)
        {
            return Request.CreateErrorResponse(
                HttpStatusCode.BadRequest,
                "Decrypted data is not valid JSON.");
        }
    }
}
